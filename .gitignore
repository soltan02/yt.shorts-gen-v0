storage/viral_playbook.json
storage/database.json

# Keep storage folder structure
!storage/.gitkeep
!storage/README.md

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
